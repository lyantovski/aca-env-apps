NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080
ENTRA_TENANT_ID=your-directory-tenant-id
ENTRA_CLIENT_ID=your-application-client-id
ENTRA_CLIENT_SECRET=your-client-secret-value
SESSION_SECRET=replace-with-at-least-32-random-characters
# Only needed for native development; the all-in-one container sets its own
# private database connection. Do not publish PostgreSQL to the internet.
DATABASE_URL=postgresql://localhost:5432/pocket_tasks
